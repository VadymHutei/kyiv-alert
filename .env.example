POLL_INTERVAL_SECONDS=10
HTTP_TIMEOUT_SECONDS=5
NOTIFICATION_MAX_AGE_SECONDS=300
HEALTH_MAX_AGE_SECONDS=120
# console writes notifications to container logs. Set telegram after adding credentials.
NOTIFIER=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: numeric ID of a topic in a Telegram forum group.
TELEGRAM_MESSAGE_THREAD_ID=
